# Which AI provider Orbit calls first: openrouter | gemini | openai | anthropic
# OpenRouter is the easiest single bill: one key reaches GPT, Claude, Gemini and Llama.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Free learners and paid learners can use different models through the same gateway.
# Defaults if you leave these out: both tiers = deepseek/deepseek-v4-flash, because measured on
# live topics it teaches better than gpt-4.1-nano and costs less. Plans differ in daily requests.
# Pinning OPENROUTER_MODEL applies to both tiers; *_FREE_MODEL / *_PAID_MODEL override it.
# OPENROUTER_MODEL=openai/gpt-4.1
# OPENROUTER_FREE_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_PAID_MODEL=deepseek/deepseek-v4-flash
# Optional: send OpenRouter traffic to a listing page of yours.
# ORBIT_SITE_URL=https://your-orbit-app.example
# If the first provider is out of daily quota, rate-limited, or busy, Orbit tries the others.
# Leave this unset to use every provider that has a key; set it to pin the exact order.
# AI_FALLBACK_PROVIDERS=openai,anthropic
# Direct provider keys (all optional; AI_MODEL is the Gemini model).
AI_MODEL=gemini-3.5-flash
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Daily AI budgets per learner. Free learners are counted per account, device id, or IP.
# One topic costs 6-11 calls (brief + lesson + one per quiz question + finish), so 15 is
# about two small topics a day on the free plan and 120 is about thirteen on Pro.
FREE_DAILY_TUTOR_CALLS=15
FREE_DAILY_ROADMAPS=2
PAID_DAILY_TUTOR_CALLS=120
PAID_DAILY_ROADMAPS=20
# How many NEW skills a learner may start in a calendar month. This count lives in the
# learner_skill Supabase table, not in server memory, so a restart cannot hand out fresh months.
# Leave PAID_MONTHLY_SKILLS unset for unlimited Pro skills.
FREE_MONTHLY_SKILLS=1
# PAID_MONTHLY_SKILLS=
# Emails that still get the paid plan without paying (you, testers, refunds to sort out).
PAID_EMAILS=
# Testing shortcut: force the "free" or "paid" model and budget for every learner,
# overriding PAID_EMAILS. Each learner still spends their own daily allowance.
# ORBIT_FORCE_TIER=paid

# Payments — Razorpay (India). A test key starts with rzp_test_ and charges nothing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in the Razorpay dashboard, which points at
# https://your-orbit-server/api/billing/webhook. Without it the plan still activates,
# but only when the learner's browser returns from checkout.
# RAZORPAY_WEBHOOK_SECRET=
# Optional, server-only: lets the webhook write plans without the learner's session.
# This is the one place a Supabase secret key belongs, and never in the app or the APK.
# SUPABASE_SERVICE_ROLE_KEY=

# Business identity shown on the public /pricing, /privacy, /terms, /refund-policy and
# /contact pages. Razorpay's reviewers read these pages before approving live payments,
# so fill them in before you submit the verification form. Until they are set, the pages
# print a "Not ready to publish" warning instead of inventing details.
ORBIT_BUSINESS_NAME=
# Must be a real inbox you monitor — refund and data requests arrive here.
ORBIT_SUPPORT_EMAIL=
# Defaults to ORBIT_SUPPORT_EMAIL if you leave it out.
# ORBIT_GRIEVANCE_EMAIL=
ORBIT_SUPPORT_PHONE=
ORBIT_BUSINESS_ADDRESS=
# Public URL of the deployed app. Already correct on Render, so optional there.
# ORBIT_SITE_URL=https://your-orbit-app.onrender.com
# The date printed as "Last updated" on the policy pages.
# ORBIT_LEGAL_DATE=2 November 2026

SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3000
